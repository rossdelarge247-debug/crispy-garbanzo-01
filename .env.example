# === Conviction - Environment Configuration ===

# Market Data Provider (polygon.io)
# Sign up: https://polygon.io/pricing — free tier available
POLYGON_API_KEY=

# Alternative: Alpaca (also provides market data + paper trading)
# Sign up: https://alpaca.markets — free paper trading account
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# News Provider
# GDELT: No key needed (public API)
# NewsAPI: https://newsapi.org — free developer tier
NEWSAPI_KEY=

# Sentiment Provider
# Alpha Vantage: https://www.alphavantage.co/support/#api-key — free tier
ALPHA_VANTAGE_KEY=

# Economic Calendar
# Finnhub: https://finnhub.io — free tier available
FINNHUB_API_KEY=

# Database (optional for Phase 2+)
DATABASE_URL=postgresql://localhost:5432/conviction
REDIS_URL=redis://localhost:6379

# App Settings
NEXT_PUBLIC_APP_MODE=demo
# Options: demo | paper | live
