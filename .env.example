# === Trade Daddy - Environment Configuration ===

# App Mode
# demo = mock data, paper = paper trading, live = real execution
NEXT_PUBLIC_APP_MODE=demo

# --- AI ANALYSIS (Claude) ---
# Powers deep analysis frameworks (narrative, opportunities, risk, scenarios)
# Without this key, rules-based analysis is used as fallback
# Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- NEWS PROVIDER ---
# Priority: NEWSAPI_KEY → GDELT (free, no key) → Mock
#
# Option 1: GDELT (free, no signup needed)
# Set this to force GDELT even in demo mode:
NEXT_PUBLIC_NEWS_PROVIDER=gdelt
#
# Option 2: NewsAPI (free dev tier, better summaries)
# Sign up: https://newsapi.org
NEWSAPI_KEY=

# --- MARKET DATA ---
# Polygon.io — free tier: 5 calls/min, delayed data
# Sign up: https://polygon.io/pricing
POLYGON_API_KEY=

# --- ECONOMIC CALENDAR ---
# Finnhub — free tier: 60 calls/min
# Sign up: https://finnhub.io
FINNHUB_API_KEY=

# --- SENTIMENT ---
# Alpha Vantage — free tier: 25 requests/day
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# --- EXECUTION (paper trading) ---
# Alpaca — free paper trading account
# Sign up: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- DATABASE (optional, Phase 2+) ---
DATABASE_URL=postgresql://localhost:5432/tradedaddy
REDIS_URL=redis://localhost:6379
